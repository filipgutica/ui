{
  "name": "@filipgutica/ui",
  "version": "0.1.0",
  "description": "A compact Vue design system with Tailwind CSS and VS Code theme support",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/theme.css",
    "src/components.css",
    "src/components/*.css",
    "src/site.css",
    "src/themes/*.css",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme.js"
    },
    "./site": {
      "types": "./dist/site/index.d.ts",
      "import": "./dist/site.js"
    },
    "./open-vsx": {
      "types": "./dist/open-vsx/index.d.ts",
      "import": "./dist/open-vsx.js"
    },
    "./theme.css": "./src/theme.css",
    "./components.css": "./src/components.css",
    "./site.css": "./src/site.css",
    "./themes/graphite-indigo.css": "./src/themes/graphite-indigo.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "docs:build": "vite build --config docs/vite.config.ts",
    "docs:dev": "vite --config docs/vite.config.ts",
    "docs:preview": "vite preview --config docs/vite.config.ts",
    "docs:smoke": "node scripts/docs-smoke.mjs",
    "docs:typecheck": "vue-tsc -p docs/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prepublishOnly": "pnpm verify",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "themes:build": "node scripts/graphite-indigo.mjs",
    "themes:check": "node scripts/graphite-indigo.mjs --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "verify": "pnpm lint && pnpm themes:check && pnpm typecheck && pnpm docs:typecheck && pnpm test && pnpm test:e2e && pnpm build && pnpm docs:build && pnpm pack --dry-run && publint"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipgutica/ui.git"
  },
  "bugs": {
    "url": "https://github.com/filipgutica/ui/issues"
  },
  "homepage": "https://github.com/filipgutica/ui#readme",
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "jsonc-parser": "^3.3.1",
    "jszip": "^3.10.1",
    "reka-ui": "^2.10.4",
    "shiki": "^3.23.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.12.2",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "swrv": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
